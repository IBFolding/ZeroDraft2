# Deployment key for the account that will own the contracts. Never commit the real one.
DEPLOYER_KEY=0x...

# Target chain. Fill these in for Robinhood Chain (or any EVM network).
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=4663

# Block explorer verification (optional)
ETHERSCAN_KEY=
EXPLORER_API_URL=
EXPLORER_URL=

# Constructor arguments
TREASURY=0x...

# Address that will OWN the contracts. Defaults to the deployer.
# Set this to a hardware wallet so your deploy key is not the key that controls things.
OWNER=
BASE_URI=https://api.mixtape.os/tape/
CONTRACT_URI=https://api.mixtape.os/collection.json
# THE ONE YOU CANNOT CHANGE. 1 billion is a normal, unremarkable supply — it is
# not special, it is just a round number nobody will question. Pick it and move on.
TAPES_CAP=1000000000
# ---------------------------------------------------------------------------
# Suggested launch values. All of these are changeable after deploy from the
# owner wallet — none of them lock you in. Start gentle, raise once people are
# actually using it. The ONLY irreversible number here is TAPES_CAP.
# ---------------------------------------------------------------------------

# 5% of each primary mint. Standard, uncontroversial.
PLATFORM_FEE_BPS=500
QUEUE_PRICE=100
BURN_BPS=7000

# What it costs a creator to publish a tape ("buying a blank"), in ETH.
# Start at 0. A brand new world has no users to lose, and a fee at the door is
# the fastest way to make sure nobody makes a first tape. Turn it on once people
# are making tapes anyway — setPublishFee() takes one transaction.
PUBLISH_FEE=0
# The platform's share of each tape's RESALE royalty, in bps of the royalty
# (not of the sale price). 3000 = 30% of a tape's royalty. Capped at 5000.
# 30% is a fair starting point: it costs a creator nothing up front and only
# ever applies if their tape resells. Note this applies to tapes published
# AFTER you set it, so it is worth setting before your first real release.
PLATFORM_ROYALTY_BPS=3000
