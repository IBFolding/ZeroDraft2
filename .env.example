# Leave these unset to run the world on mock data (demo mode).
# After deploying, copy from contracts/deployments/<network>.json:
VITE_MIXTAPE_ADDRESS=
VITE_TAPES_ADDRESS=
VITE_JUKEBOX_ADDRESS=

# Dedicated RPC (the public Robinhood Chain endpoint is rate-limited)
VITE_RPC_URL=

# "robinhood" (default), "baseSepolia" for testnet, or "localhost" for a hardhat node
VITE_CHAIN=
VITE_DEPLOY_BLOCK=
VITE_BASE_URI=

# Optional: a Pinata JWT so creators don't each need to paste one.
# Leave unset and the Tape Shop asks the creator for their own key.
VITE_PINATA_JWT=
